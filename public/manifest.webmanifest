{
  "id": "/",
  "name": "InnovationTECH Studio",
  "short_name": "IT Studio",
  "description": "Crea textos, imágenes y videos de marketing con IA. Open source.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070d1f",
  "theme_color": "#070d1f",
  "categories": ["productivity", "business", "photo"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "/screenshots/escritorio.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Crear textos de marketing en InnovationTECH Studio"
    },
    {
      "src": "/screenshots/movil.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Crear imágenes desde el celular"
    }
  ],
  "shortcuts": [
    { "name": "Crear textos", "url": "/?tab=texto", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Crear imágenes", "url": "/?tab=imagen", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Crear videos", "url": "/?tab=video", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
